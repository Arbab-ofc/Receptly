NODE_ENV=development
PORT=3001
# Comma-separated frontend origins. Use your exact HTTPS origin in production.
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
WHATSAPP_SESSION_DIR=./data/whatsapp-sessions
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_SUPPORT_EMAIL=

# Public production origin for canonical links and absolute sharing images.
VITE_SITE_URL=

# Optional operational settings. Zero disables message/log deletion.
MESSAGE_RETENTION_DAYS=0
LOG_RETENTION_DAYS=0
SSE_MAX_CONNECTIONS_PER_USER=3
SEND_TIMEOUT_MS=30000
ALERT_JOB_AGE_MINUTES=60
# Set a long random token to enable the private operations endpoint.
OPERATIONS_TOKEN=
ALERT_WEBHOOK_URL=
# 32-byte hexadecimal key; keep it separately from encrypted backup files.
BACKUP_ENCRYPTION_KEY=

# Platform administrators: comma-separated Firebase Authentication user UIDs (server only).
ADMIN_UIDS=

# Manual subscription payments: set both before accepting requests.
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=
# Automatic replies and follow-ups always require Pro (paid subscription or admin grant).

# Optional payment-review alerts. Link the separate sender in Admin panel → Subscription payments.
# Country code + number, digits only (e.g. 919876543210). Admin recipient only.
PAYMENT_NOTIFY_WHATSAPP_NUMBER=
